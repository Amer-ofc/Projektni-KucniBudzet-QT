  <property name="styleSheet">
   <string notr="true">/* Main background */
QMainWindow {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1,
        stop:0 #667eea, stop:1 #764ba2);
    font-family: &quot;Segoe UI&quot;;
}

/* Login card */
QFrame#loginFrame {
    background-color: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 16px;
    padding: 18px;
}

/* Title */
QLabel#label {
    color: white;
    font-weight: 700;
    font-size: 22px; /* Designer će kontrolirati realnu visinu */
}

/* Rows: icon QLabel + QLineEdit siting inside horizontal layout */

/* QLineEdit: ima lijevi padding iznad (ostavi mjesto za ikonicu) */
QLineEdit {
    background-color: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 10px;
    padding: 10px 12px 10px 12px; /* padding unutar polja */
    color: white;
    font-size: 14px;
}

/* Focus effect */
QLineEdit:focus {
    border: 1px solid #06b6d4;
    background-color: rgba(255,255,255,0.09);
}

/* Push button */
QPushButton#pushButton {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0,
        stop:0 #6366f1, stop:1 #06b6d4);
    color: white;
    border-radius: 10px;
    padding: 10px;
    font-weight: 700;
}


QLabel[scaledContents=&quot;true&quot;] {
}

QMainWindow {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #667eea, stop:1 #764ba2);
    border-image: url(:/slike/img.jpg) 0 0 0 0 stretch stretch; 
}</string>
