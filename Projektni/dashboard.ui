   <string notr="true">
QMainWindow {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #667eea, stop:1 #764ba2);
    font-family: &quot;Segoe UI&quot;;
}

QWidget#sidebar {
    background: rgba(0,0,0,0.12);
    border-right: 1px solid rgba(255,255,255,0.06);
}
QLabel#appTitle {
    color: white;
    font-size: 18px;
    font-weight: 700;
    padding: 12px 16px;
}
QPushButton.sideBtn {
    color: rgba(255,255,255,0.9);
    background: transparent;
    border: none;
    text-align: left;
    padding: 10px 16px;
    font-size: 14px;
}
QPushButton.sideBtn:hover {
    background: rgba(255,255,255,0.04);
}

QFrame.card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 10px;
    padding: 14px;
}
QLabel.cardTitle { color: rgba(255,255,255,0.8); font-size:12px; }
QLabel.cardValue { color: white; font-size:20px; font-weight:700; }

QTableView {
    background: rgba(255,255,255,0.03);
    gridline-color: rgba(255,255,255,0.06);
    color: white;
    selection-background-color: rgba(99,102,241,0.3);
    alternate-background-color: rgb(0, 0, 0);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 6px;
}
QHeaderView::section {
    background: rgba(255,255,255,0.04);
    color: rgb(119, 73, 255);
    padding: 6px;
    border: none;
}

QPushButton#btnDodajPrihod, QPushButton#btnDodajRashod {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #6366f1, stop:1 #06b6d4);
    color: white;
    border-radius: 8px;
    padding: 8px 12px;
    font-weight: 700;
}
